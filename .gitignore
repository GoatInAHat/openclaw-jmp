# Personal data - contains phone numbers and names
config/verified_owners.json
config/known_contacts.json
config/blocked_numbers.json
config/daemon.json
config/.pending_challenges.json
config/.pending_verifications.json

# Runtime data - logs and profiles
data/
logs/
message_history.jsonl
config/verification_audit.jsonl
config/challenge_audit.jsonl

# Keep only example configs in version control
!config/*.example.json

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.bak
